#!/bin/sh /etc/rc.common
# OpenWrt procd script for miniddns (design.md §12.6). No systemd available.
USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/miniddns

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" --foreground
    procd_set_param respawn 3600 5 5
    procd_set_param limits core="0 0"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd handles SIGTERM; the daemon exits cleanly via signalfd.
    :
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "miniddns"
}
