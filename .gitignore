# build artifacts
/build/
/dist/
/tests/build/
/doc/
/release-assets/
*.o
*.a
# NOTE: do NOT add a bare `*.d` rule — it would also match the required
# systemd/miniddns.service.d/ drop-in directory. Dependency files live only
# under build/ and tests/build/, which are already ignored above.

# generated by `make ca-refresh` (part of the dist artifact, not source)
/ca/ca-certificates.crt
/ca/README

# generated systemd unit (source of truth is systemd/miniddns.service.in)
# keep this line commented if the pre-generated unit is tracked; see design.md §12.3
# systemd/miniddns.service

# local config & secrets — MUST never be committed or packaged
conf/miniddns.conf
*.token
*.key
credentials/

# editor / OS noise
*.swp
*~
.DS_Store
.idea/
.vscode/

# test / fuzz artifacts
/tests/tmp/
*.gcda
*.gcno
core
core.*

# python test caches
__pycache__/
*.pyc

# agent harness artifacts (never part of the project)
/.rpi/
